filters:
  and:
    - file.inFolder("notes/taches")
properties:
  id:
    displayName: ID
  statut:
    displayName: Statut
  priorite:
    displayName: Priorité
  fait_le:
    displayName: Fait le
views:
  - type: kanban
    name: Kanban
    groupBy:
      property: statut
      direction: ASC
    order:
      - file.name
      - priorite
  - type: table
    name: Tableau
    groupBy:
      property: statut
      direction: ASC
    order:
      - id
      - file.name
      - priorite
      - fait_le
  - type: table
    name: MVP à faire
    filters:
      and:
        - priorite == "MVP"
        - statut != "4. Fait"
    order:
      - id
      - file.name
      - statut
