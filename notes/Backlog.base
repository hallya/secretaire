filters:
  and:
    - file.inFolder("notes/taches")

properties:
  id:
    displayName: ID
  statut:
    displayName: Statut
  priorite:
    displayName: Priorité
  fait_le:
    displayName: Fait le

views:
  - type: kanban
    name: Kanban
    order:
      - file.name
      - priorite
    groupBy:
      property: statut
      direction: ASC
  - type: table
    name: Tableau
    order:
      - id
      - file.name
      - priorite
      - fait_le
    groupBy:
      property: statut
      direction: ASC
  - type: table
    name: MVP à faire
    filters:
      and:
        - 'priorite == "MVP"'
        - 'statut != "4. Fait"'
    order:
      - id
      - file.name
      - statut
