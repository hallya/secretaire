filters:
  and:
    - file.inFolder("notes/decisions")
properties:
  id:
    displayName: ID
  statut:
    displayName: Statut
  date:
    displayName: Date
  origine:
    displayName: Origine
views:
  - type: table
    name: Toutes
    groupBy:
      property: statut
      direction: ASC
    order:
      - id
      - file.name
      - date
      - origine
  - type: table
    name: En attente
    filters:
      or:
        - statut == "1. À prendre"
        - statut == "2. Proposée"
    order:
      - id
      - file.name
      - date
