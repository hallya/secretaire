filters:
  and:
    - file.inFolder("notes/decisions")

properties:
  id:
    displayName: ID
  statut:
    displayName: Statut
  date:
    displayName: Date
  origine:
    displayName: Origine

views:
  - type: table
    name: Toutes
    order:
      - id
      - file.name
      - date
      - origine
    groupBy:
      property: statut
      direction: ASC
  - type: table
    name: En attente
    filters:
      or:
        - 'statut == "1. À prendre"'
        - 'statut == "2. Proposée"'
    order:
      - id
      - file.name
      - date
